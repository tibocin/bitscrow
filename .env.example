# File: .env.example
# Purpose: Names RPC + GlitchTip env vars. Copy to gitignored .env; never commit live hosts/DSN.
# Related: docs/fork_capability_matrix.md, docs/ops/glitchtip.md, AGENTS.md
# Tags: #env #rpc #glitchtip #privacy
#
# CI does not load this file and must not call the node or GlitchTip.
# Agents never receive BITSCROW_RPC_PASSWORD, live RPC locators, or live DSN.
# Shop policy: sibling devao docs/policies/bitcoin-privacy.md
# Obs HITL: sibling devao docs/governance/runtime-obs-glitchtip-setup.md

# Placeholders only. Real URL lives in gitignored .env or 1Password.
BITSCROW_RPC_URL=https://<lan-host>:<rpc-port>

# Tor hidden service — same JSON-RPC, also a locator, not for git.
# BITSCROW_RPC_URL=https://<rpc-onion>.onion

# Prefer .env.op.example + `op run` (DEVAO secret-injection).
BITSCROW_RPC_USER=
BITSCROW_RPC_PASSWORD=

# GlitchTip DSN — three projects only (local / staging / prod). Never commit a live value.
# Prefer .env.op.example + `op run`. Angle-bracket form is a shape, not a secret.
# GLITCHTIP_DSN_LOCAL=https://<public-key>@<glitchtip-host>/<project-id>
# GLITCHTIP_DSN_STAGING=https://<public-key>@<glitchtip-host>/<project-id>
# GLITCHTIP_DSN_PROD=https://<public-key>@<glitchtip-host>/<project-id>
GLITCHTIP_DSN_LOCAL=
GLITCHTIP_DSN_STAGING=
GLITCHTIP_DSN_PROD=
