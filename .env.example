# File: .env.example
# Purpose: Names the RPC env vars. Copy to .env locally; never commit values.
# Related: docs/fork_capability_matrix.md, AGENTS.md
# Tags: #env #rpc #secrets
#
# CI does not load this file and must not call the node.
# Agents never receive BITSCROW_RPC_PASSWORD.

# LAN (StartOS TLS, self-signed). HTTP on this port 307s to HTTPS.
BITSCROW_RPC_URL=https://192.168.4.177:57713

# Tor hidden service (operator-provided). Same JSON-RPC, not for CI.
# BITSCROW_RPC_URL=https://ka7mzfmkd44ulghs56zoyqejizulqd4guf7waqoa3ejffojekub4idyd.onion

# Prefer .env.op.example + `op run` (DEVAO secret-injection). Leave these blank
# if you copy this file to gitignored .env for human-only tools.
BITSCROW_RPC_USER=
BITSCROW_RPC_PASSWORD=
