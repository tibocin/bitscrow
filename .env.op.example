# File: .env.op.example
# Purpose: 1Password refs for op run. Copy to gitignored .env.op.
# Related: .env.example, docs/fork_capability_matrix.md
# Tags: #env #opsec #1password
#
# Why: locators and passwords stay in the vault. op injects them into one
# child process. Agents must not Read .env.op after inject-to-disk.

BITSCROW_RPC_URL=op://Personal/BITSCROW RPC/url
BITSCROW_RPC_USER=op://Personal/BITSCROW RPC/username
BITSCROW_RPC_PASSWORD=op://Personal/BITSCROW RPC/password
