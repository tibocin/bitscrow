# File: .env.op.example
# Purpose: 1Password refs for op run. Copy to gitignored .env.op.
# Related: .env.example, docs/fork_capability_matrix.md, docs/ops/glitchtip.md
# Tags: #env #opsec #1password #glitchtip
#
# Why: locators, passwords, and GlitchTip DSN stay in the vault. op injects
# them into one child process. Agents must not Read .env.op after inject-to-disk.
# Path shapes match sibling shop docs/governance/runtime-obs-glitchtip-setup.md.
# Stephen must create the vault items and paste real DSN values (human go).

BITSCROW_RPC_URL=op://Personal/BITSCROW RPC/url
BITSCROW_RPC_USER=op://Personal/BITSCROW RPC/username
BITSCROW_RPC_PASSWORD=op://Personal/BITSCROW RPC/password

# GlitchTip — refs only. Plaintext DSN never belongs in git.
GLITCHTIP_DSN_LOCAL=op://Personal/BITSCROW GlitchTip local/credential
GLITCHTIP_DSN_STAGING=op://Personal/BITSCROW GlitchTip staging/credential
GLITCHTIP_DSN_PROD=op://Personal/BITSCROW GlitchTip prod/credential
