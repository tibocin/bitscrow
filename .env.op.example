# File: .env.op.example
# Purpose: 1Password op:// refs for op run. Copy to gitignored .env.op.
# Related: docs/policies/secret-injection.md (DEVAO), scripts/check_phase0.py
# Tags: #opsec #1password #rpc
#
# Copy to .env.op then: op run --env-file=.env.op -- <redacting command>
# Never op inject into .env while an agent is in this repo.

BITSCROW_RPC_URL=https://192.168.4.177:57713
BITSCROW_RPC_USER=op://Personal/BITSCROW RPC/username
BITSCROW_RPC_PASSWORD=op://Personal/BITSCROW RPC/password
