# File: .gitignore
# Purpose: Keep wallets, RPC cookies, env secrets, and build junk out of git.
# Related: docs/fork_capability_matrix.md, .env.example, sibling shop examples/product-runtime/gitignore.snippet
# Tags: #gitignore #secrets #devops #dual-root

# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Env and local operator config (never commit RPC passwords or live hosts)
.env
.env.*
!.env.example
!.env.op.example

# Keys, wallets, Bitcoin-style RPC cookies
*.pem
*.key
*.p12
wallet.dat
*.cookie
.cookie
*.mnemonic
*.seed

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# DEVAO live runtime — do not commit chalkboards or traces
# Copied from sibling shop examples/product-runtime/gitignore.snippet
.devao/chalkboard/*.json
.devao/traces/*.jsonl
.devao/bundles/*.json
.devao/intents/*.json
.devao/learning/**
.devao/board/**
.devao/model-routing.json
!.devao/chalkboard/.gitkeep
!.devao/traces/.gitkeep
!.devao/bundles/.gitkeep
!.devao/intents/.gitkeep
!.devao/learning/.gitkeep
!.devao/board/.gitkeep
